{
  // Optional edge worker. See edge/README.md — the site works without it.
  "name": "awesome-reviewers-edge",
  "main": "worker.js",
  "compatibility_date": "2026-08-21",
  "routes": [
    { "pattern": "awesomereviewers.com/*", "zone_name": "awesomereviewers.com" }
  ],
  "vars": {
    // Set this only if a subrequest to the route would re-enter the worker.
    // "ORIGIN": "https://baz-scm.github.io"
  },
  // The quota published in /v1/version.json and advertised in RateLimit-Policy:
  // 600 requests per 60 seconds per client IP. Without this binding the worker
  // still advertises the policy and enforces nothing. `simple.limit` and
  // `simple.period` must match RATE_LIMIT in worker.js, which mirrors
  // RATE_LIMIT_* in build_data.py.
  "unsafe": {
    "bindings": [
      {
        "name": "RATE_LIMITER",
        "type": "ratelimit",
        "namespace_id": "1001",
        "simple": { "limit": 600, "period": 60 }
      }
    ]
  }
}
