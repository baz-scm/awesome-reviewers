#!/usr/bin/env python3
"""Entry point. No install step, no dependencies — run it from a checkout.

The directory holding this file is prepended to sys.path so `awesome_harness`
imports whether or not anything was installed. That is the point: a harness that
needs to be installed before it can gate a change is a harness that will not run in
the one environment you most want it in, which is somebody else's CI.
"""

from __future__ import annotations

import sys
from pathlib import Path

# 3.9 for Path.is_relative_to (path confinement) and 3.11 for tomllib-era stdlib
# behaviour we rely on elsewhere. Checked before any import that would fail obscurely.
if sys.version_info < (3, 9):  # pragma: no cover
    sys.stderr.write(
        f"awesome-harness needs Python 3.9 or newer (found {sys.version.split()[0]}); "
        "Path.is_relative_to is required for path confinement\n"
    )
    raise SystemExit(78)

sys.path.insert(0, str(Path(__file__).resolve().parent))

from awesome_harness.cli import main  # noqa: E402 - after the sys.path bootstrap

if __name__ == "__main__":
    raise SystemExit(main())
